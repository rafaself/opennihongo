{
  "name": "@opennihongo/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint . --no-error-on-unmatched-pattern --max-warnings=0",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@opennihongo/audio-assets": "workspace:*",
    "@opennihongo/content": "workspace:*",
    "@opennihongo/core": "workspace:*",
    "@opennihongo/persistence": "workspace:*",
    "@opennihongo/ui": "workspace:*",
    "@tanstack/react-router": "1.170.38",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "type:app"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "jsdom": "28.1.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "5.0.1"
  }
